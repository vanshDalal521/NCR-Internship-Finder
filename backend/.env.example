# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database — Supabase (recommended for production)
# Leave blank to use the local JSON development store.
# Create a project at https://supabase.com, then run
# database/migrations/001_initial_schema.sql and 002_realtime_screening.sql
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: path of the local JSON store (development fallback only)
LOCAL_STORE_FILE=./data/local-db.json

# ---------------------------------------------------------------------------
# Job discovery
# JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Adzuna:  https://developer.adzuna.com/
# ---------------------------------------------------------------------------
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_COUNTRY=in

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Safety limit: maximum saved searches per rolling 24 hours
DISCOVERY_DAILY_LIMIT=40
DISCOVERY_MAX_AGE_DAYS=45

# Only show roles posted within this many hours (verified-active roles stay visible)
JOB_FRESHNESS_HOURS=24

# ---------------------------------------------------------------------------
# Live automation
# ---------------------------------------------------------------------------
# Screen application links + queue Gemini analysis for every new record.
AUTO_SCREEN_ENABLED=true
AUTO_ANALYSIS_LIMIT=4

# Optional: auto-promote screened records above the score threshold to verified_active.
# Leave false so a committee member remains the final verification gate.
AUTO_VERIFY_SCREENED=false
AUTO_VERIFY_MIN_SCORE=60

# Scheduled live discovery. Keep the monthly budget below your JSearch plan.
AUTO_DISCOVERY_ENABLED=false
AUTO_DISCOVERY_INTERVAL_MINUTES=240
AUTO_DISCOVERY_START_DELAY_SECONDS=30
AUTO_DISCOVERY_SEARCHES_PER_RUN=1
AUTO_DISCOVERY_MONTHLY_BUDGET=180

# ---------------------------------------------------------------------------
# Gemini AI
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Committee access
# Set APP_PASSWORD to protect the application in production.
# When blank in development, authentication is disabled.
# Use a long random value for AUTH_SECRET (32+ characters).
# ---------------------------------------------------------------------------
APP_PASSWORD=
AUTH_SECRET=
SESSION_TTL_HOURS=12

# Comma-separated allowed origins for deployed frontend(s)
# FRONTEND_ORIGIN supports only one origin; use ALLOWED_ORIGINS for extras.
ALLOWED_ORIGINS=

# Only set to true for an intentional public demo with no APP_PASSWORD.
# Leave false for committee-only deployments.
ALLOW_PUBLIC_ACCESS=false
